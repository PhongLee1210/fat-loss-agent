# Any OpenAI-compatible provider; defaults target local Qwen via Ollama.
# Ollama:      http://localhost:11434/v1  (LLM_MODEL=qwen3:8b)
# LM Studio:   http://localhost:1234/v1
# OpenAI:      https://api.openai.com/v1  (LLM_MODEL=gpt-4o-mini)
# DeepSeek:    https://api.deepseek.com/v1 (LLM_MODEL=deepseek-chat)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

# Local Supabase Postgres (supabase start)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
